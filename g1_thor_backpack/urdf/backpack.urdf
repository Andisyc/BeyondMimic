<robot name="thor_backpack_standalone">
  <link name="mount_reference" />
  <link name="thor_backpack_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.9" />
      <inertia ixx="0.015510" ixy="0.000017" ixz="0.000563" iyy="0.010909" iyz="0.000059" izz="0.007288" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/backpack_link.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/backpack_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="thor_backpack_joint" type="fixed">
    <origin xyz="-0.094605 -0.0005 0.165324" rpy="0 0 0" />
